{
  "name": "@oh-new-editor/core",
  "version": "0.2.0",
  "description": "Core engine for Oh New Editor",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/choiyoh/oh-new-editor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/choiyoh/oh-new-editor#readme",
  "bugs": {
    "url": "https://github.com/choiyoh/oh-new-editor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./markdown": {
      "types": "./dist/src/markdown.d.ts",
      "import": "./dist/markdown.mjs",
      "require": "./dist/markdown.cjs"
    },
    "./notion": {
      "types": "./dist/src/notion.d.ts",
      "import": "./dist/notion.mjs",
      "require": "./dist/notion.cjs"
    },
    "./table": {
      "types": "./dist/src/table.d.ts",
      "import": "./dist/table.mjs",
      "require": "./dist/table.cjs"
    },
    "./toolbar": {
      "types": "./dist/src/toolbar.d.ts",
      "import": "./dist/toolbar.mjs",
      "require": "./dist/toolbar.cjs"
    },
    "./ai": {
      "types": "./dist/src/ai.d.ts",
      "import": "./dist/ai.mjs",
      "require": "./dist/ai.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "rm -rf dist && vite build",
    "dev": "vite build --watch",
    "size-check": "node ../../scripts/check-size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "prosemirror",
    "markdown",
    "headless"
  ],
  "author": "choiyoh",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.2.7",
    "marked": "^16.3.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.0",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.1",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.41.3",
    "turndown": "^7.2.1"
  },
  "devDependencies": {
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  }
}
