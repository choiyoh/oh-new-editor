{
  "name": "@oh-new-editor/vue",
  "version": "0.1.0",
  "description": "Vue adapter for Oh New Editor",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/choiyoh/oh-new-editor.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/choiyoh/oh-new-editor#readme",
  "bugs": {
    "url": "https://github.com/choiyoh/oh-new-editor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@oh-new-editor/core": "workspace:^",
    "vue": ">=3"
  },
  "devDependencies": {
    "@oh-new-editor/core": "workspace:*",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.22"
  },
  "author": "choiyoh",
  "license": "MIT",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "prosemirror",
    "vue"
  ]
}
