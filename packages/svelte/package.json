{
  "name": "@oh-new-editor/svelte",
  "version": "0.1.1",
  "description": "Svelte adapter for Oh New Editor",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/svelte/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/choiyoh/oh-new-editor.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/choiyoh/oh-new-editor#readme",
  "bugs": {
    "url": "https://github.com/choiyoh/oh-new-editor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && vite build && svelte-package --input src --output dist/svelte",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "@oh-new-editor/core": "workspace:^",
    "svelte": ">=5"
  },
  "devDependencies": {
    "@oh-new-editor/core": "workspace:*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^26.1.0",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.1",
    "typescript": "^6.0.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "author": "choiyoh",
  "license": "MIT",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "prosemirror",
    "svelte"
  ]
}
