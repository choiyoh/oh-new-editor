{
  "name": "@oh-new-editor/react",
  "version": "0.1.1",
  "description": "React adapter for Oh New Editor",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/choiyoh/oh-new-editor.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/choiyoh/oh-new-editor#readme",
  "bugs": {
    "url": "https://github.com/choiyoh/oh-new-editor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@oh-new-editor/core": "workspace:^",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@oh-new-editor/core": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "author": "choiyoh",
  "license": "MIT",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "prosemirror",
    "react"
  ]
}
